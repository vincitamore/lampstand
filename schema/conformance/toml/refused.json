{
  "about": "TOML that lampstand refuses. Parsing `input` read from the file `vector.toml` fails with error.code, naming vector.toml and error.line, and the message contains error.message. `subset: true` marks valid TOML 1.0 that is outside the subset; the rest is malformed TOML.",
  "vectors": [
    { "description": "array of tables", "subset": true, "input": "a = 1\n[[products]]\nname = \"x\"\n", "error": { "code": "E_PARSE_TOML", "line": 2, "message": "array of tables" } },
    { "description": "multi-line basic string", "subset": true, "input": "a = 1\n\nb = \"\"\"\ntext\"\"\"\n", "error": { "code": "E_PARSE_TOML", "line": 3, "message": "multi-line basic string" } },
    { "description": "multi-line literal string", "subset": true, "input": "b = '''\ntext'''\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "multi-line literal string" } },
    { "description": "offset date-time", "subset": true, "input": "[t]\nd = 1979-05-27T07:32:00Z\n", "error": { "code": "E_PARSE_TOML", "line": 2, "message": "date-time" } },
    { "description": "local date-time with a space", "subset": true, "input": "d = 1979-05-27 07:32:00\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "date-time" } },
    { "description": "local date", "subset": true, "input": "x = 1\nd = 1979-05-27\n", "error": { "code": "E_PARSE_TOML", "line": 2, "message": "date-time" } },
    { "description": "local time", "subset": true, "input": "t = 07:32:00\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "date-time" } },
    { "description": "hexadecimal integer", "subset": true, "input": "\n\nh = 0xDEADBEEF\n", "error": { "code": "E_PARSE_TOML", "line": 3, "message": "hexadecimal integer" } },
    { "description": "octal integer", "subset": true, "input": "o = 0o755\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "octal integer" } },
    { "description": "binary integer", "subset": true, "input": "b = 0b1101\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "binary integer" } },
    { "description": "infinity", "subset": true, "input": "f = +inf\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "special float" } },
    { "description": "not a number", "subset": true, "input": "f = nan\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "special float" } },
    { "description": "date inside an array", "subset": true, "input": "a = [\n  1979-05-27,\n]\n", "error": { "code": "E_PARSE_TOML", "line": 2, "message": "date-time" } },
    { "description": "an integer beyond 2^53-1 is refused rather than rounded", "subset": true, "input": "n = 9007199254740993\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "exactly representable" } },
    { "description": "newline inside an inline table", "input": "t = { a = 1,\n  b = 2 }\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "newline inside an inline table" } },
    { "description": "duplicate key", "input": "a = 1\nb = 2\na = 3\n", "error": { "code": "E_PARSE_TOML", "line": 3, "message": "duplicate key a" } },
    { "description": "duplicate key through dotted keys", "input": "a.b = 1\na.b = 2\n", "error": { "code": "E_PARSE_TOML", "line": 2, "message": "duplicate key a.b" } },
    { "description": "duplicate key inside a table is named with its table", "input": "[t]\na = 1\n\"a\" = 2\n", "error": { "code": "E_PARSE_TOML", "line": 3, "message": "duplicate key t.a" } },
    { "description": "duplicate key inside an inline table is named with its parent key", "input": "x = { a = 1, a = 2 }\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "duplicate key x.a" } },
    { "description": "table defined twice", "input": "[t]\nx = 1\n[t]\ny = 2\n", "error": { "code": "E_PARSE_TOML", "line": 3, "message": "defined twice" } },
    { "description": "dotted keys cannot extend a table defined by a header", "input": "[a.b]\nx = 1\n[a]\nb.y = 2\n", "error": { "code": "E_PARSE_TOML", "line": 4, "message": "cannot add keys to a.b: it is already defined" } },
    { "description": "a header cannot define a table made by dotted keys", "input": "[fruit]\napple.color = \"red\"\n[fruit.apple]\n", "error": { "code": "E_PARSE_TOML", "line": 3, "message": "already defined by dotted keys" } },
    { "description": "an inline table cannot be extended by a header", "input": "a = { x = 1 }\n[a.b]\n", "error": { "code": "E_PARSE_TOML", "line": 2, "message": "inline table" } },
    { "description": "an inline table cannot be extended by dotted keys", "input": "a = { x = 1 }\na.y = 2\n", "error": { "code": "E_PARSE_TOML", "line": 2, "message": "already defined" } },
    { "description": "a value cannot become a table", "input": "a = 1\n[a]\n", "error": { "code": "E_PARSE_TOML", "line": 2, "message": "already defined as a value" } },
    { "description": "unterminated basic string", "input": "s = \"open\nt = 1\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "unterminated basic string" } },
    { "description": "unterminated literal string", "input": "\ns = 'open\n", "error": { "code": "E_PARSE_TOML", "line": 2, "message": "unterminated literal string" } },
    { "description": "invalid escape", "input": "s = \"bad \\q\"\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "invalid escape \\q" } },
    { "description": "unicode escape naming a surrogate", "input": "s = \"\\uD800\"\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "invalid unicode escape" } },
    { "description": "control character in a string", "input": "s = \"a\u0001b\"\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "control character" } },
    { "description": "leading zero", "input": "n = 007\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "leading zeros" } },
    { "description": "an unquoted string", "input": "[t]\nname = ana\n", "error": { "code": "E_PARSE_TOML", "line": 2, "message": "a string needs quotes" } },
    { "description": "a missing value", "input": "a =\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "expected a value" } },
    { "description": "a key without equals sign", "input": "a = 1\nb\n", "error": { "code": "E_PARSE_TOML", "line": 2, "message": "expected = after key b" } },
    { "description": "two values on one line", "input": "a = 1 b = 2\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "expected end of line" } },
    { "description": "trailing comma in an inline table", "input": "t = { a = 1, }\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "trailing comma" } },
    { "description": "unterminated array", "input": "a = [1, 2\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "unterminated array" } },
    { "description": "a float without digits after the point", "input": "f = 1.\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "unrecognized value" } },
    { "description": "a lone carriage return", "input": "a = 1\rb = 2\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "carriage return" } },
    { "description": "an unclosed table header", "input": "[t\n", "error": { "code": "E_PARSE_TOML", "line": 1, "message": "expected ] to close" } }
  ]
}
