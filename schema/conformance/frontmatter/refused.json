{
  "about": "Frontmatter that lampstand refuses. Parsing `input` read from the file `vector.md` fails with error.code, naming vector.md and error.line (a line of the whole file, so the first frontmatter line is line 2), and the message contains error.message. `subset: true` marks valid YAML that is outside the subset; the rest is malformed or ambiguous.",
  "vectors": [
    { "description": "anchor", "subset": true, "input": "---\na: &base 1\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "anchor" } },
    { "description": "alias", "subset": true, "input": "---\na: 1\nb: *base\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 3, "message": "alias" } },
    { "description": "anchor on a sequence item", "subset": true, "input": "---\nl:\n  - &x a\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 3, "message": "anchor" } },
    { "description": "tag", "subset": true, "input": "---\na: !!str 1\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "tag" } },
    { "description": "local tag", "subset": true, "input": "---\na: !custom x\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "tag" } },
    { "description": "tag on a key", "subset": true, "input": "---\n!!str k: v\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "tag" } },
    { "description": "alias inside a flow sequence", "subset": true, "input": "---\na: [1, *x]\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "alias" } },
    { "description": "document end marker (multiple documents)", "subset": true, "input": "---\na: 1\n...\nb: 2\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 3, "message": "document marker" } },
    { "description": "directive", "subset": true, "input": "---\n%YAML 1.2\na: 1\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "directive" } },
    { "description": "complex key", "subset": true, "input": "---\n? a\n: b\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "complex key" } },
    { "description": "flow sequence as a key", "subset": true, "input": "---\n[a, b]: c\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "complex key" } },
    { "description": "flow mapping as a key", "subset": true, "input": "---\n{a: 1}: c\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "complex key" } },
    { "description": "block scalar indentation indicator", "subset": true, "input": "---\na: |2\n  text\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "block scalar indentation indicator" } },
    { "description": "block scalar indentation indicator after chomping", "subset": true, "input": "---\na: >-1\n text\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "block scalar indentation indicator" } },
    { "description": "text after a block scalar header", "input": "---\na: | text\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "unexpected text after a block scalar header" } },
    { "description": "a block scalar line less indented than its first line", "input": "---\na: |\n    first\n  second\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 4, "message": "unexpected indentation" } },
    { "description": "a leading empty line indented past the block scalar's first line", "input": "---\na: |\n      \n  text\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 4, "message": "leading empty line" } },
    { "description": "a tab indenting a block scalar", "input": "---\na: |\n\ttext\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 3, "message": "tab character in indentation" } },
    { "description": "a block scalar indicator inside a flow sequence", "input": "---\na: [|]\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "block scalar" } },
    { "description": "flow mapping key without a value", "subset": true, "input": "---\na: {b, c: 1}\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "flow mapping key without a value" } },
    { "description": "plain flow mapping key glued to its value", "subset": true, "input": "---\na: {b:1}\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "flow mapping key without a value" } },
    { "description": "duplicate key in a flow mapping", "input": "---\na: {b: 1, b: 2}\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "duplicate key" } },
    { "description": "empty entry in a flow mapping", "input": "---\na: {b: 1, , c: 2}\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "empty entry in a flow mapping" } },
    { "description": "flow collection as a flow mapping key", "subset": true, "input": "---\na: {[b]: 1}\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "complex key" } },
    { "description": "anchor inside a flow mapping", "subset": true, "input": "---\na: {b: &x 1}\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "anchor" } },
    { "description": "single-pair mapping inside a flow sequence", "subset": true, "input": "---\na: [b: 1]\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "mapping inside a flow sequence" } },
    { "description": "multi-line plain scalar", "subset": true, "input": "---\ndescription: first part\n  second part\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 3, "message": "multi-line plain scalar" } },
    { "description": "multi-line plain scalar in a sequence", "subset": true, "input": "---\nl:\n  - first\n    second\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 4, "message": "multi-line plain scalar" } },
    { "description": "multi-line double-quoted scalar", "subset": true, "input": "---\na: \"first\n  second\"\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "multi-line quoted scalar" } },
    { "description": "multi-line single-quoted scalar", "subset": true, "input": "---\na: 'first\n  second'\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "multi-line quoted scalar" } },
    { "description": "multi-line plain scalar inside a flow sequence", "subset": true, "input": "---\na: [one\n  two]\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 3, "message": "multi-line plain scalar" } },
    { "description": "multi-line quoted scalar inside a flow sequence", "subset": true, "input": "---\na: [\"one\n  two\"]\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "multi-line quoted scalar" } },
    { "description": "a flow sequence continued on a line not indented past its key", "input": "---\na: [1,\nb: 2]\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 3, "message": "not indented past its key" } },
    { "description": "a flow sequence that never closes", "input": "---\na: [1, 2\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "never closed" } },
    { "description": "a flow mapping that never closes", "input": "---\na: {b: 1,\n  c: 2\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "never closed" } },
    { "description": "text after a multi-line flow collection closes", "input": "---\na: [1,\n  2] x\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 3, "message": "unexpected text after a value" } },
    { "description": "hexadecimal integer", "subset": true, "input": "---\nmode: 0x1F\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "hexadecimal or octal integer" } },
    { "description": "octal integer", "subset": true, "input": "---\nmode: 0o755\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "hexadecimal or octal integer" } },
    { "description": "special float", "subset": true, "input": "---\nx: .inf\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "special float" } },
    { "description": "an integer beyond 2^53-1 is refused rather than rounded", "subset": true, "input": "---\nn: 9007199254740993\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "exactly representable" } },
    { "description": "YAML 1.1 boolean yes is ambiguous", "input": "---\nenabled: yes\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "ambiguous plain scalar yes" } },
    { "description": "YAML 1.1 boolean off is ambiguous", "input": "---\nl: [on, Off]\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "ambiguous plain scalar on" } },
    { "description": "leading-zero integer is ambiguous", "input": "---\nmode: 0755\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "ambiguous integer 0755" } },
    { "description": "frontmatter that is never closed", "input": "---\na: 1\nbody text\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 1, "message": "never closed" } },
    { "description": "a lone opening fence", "input": "---", "error": { "code": "E_PARSE_FRONTMATTER", "line": 1, "message": "never closed" } },
    { "description": "tab in indentation", "input": "---\na:\n\tb: 1\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 3, "message": "tab character in indentation" } },
    { "description": "duplicate key", "input": "---\na: 1\nb: 2\na: 3\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 4, "message": "duplicate key \"a\"" } },
    { "description": "top-level sequence", "input": "---\n- a\n- b\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "must be a mapping" } },
    { "description": "top-level scalar", "input": "---\njust text\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "expected a mapping entry" } },
    { "description": "a mapping on the same line as its key", "input": "---\na: b: c\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "mapping cannot start on the same line" } },
    { "description": "a sequence on the same line as its key", "input": "---\na: - b\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "sequence cannot start on the same line" } },
    { "description": "inconsistent indentation", "input": "---\na:\n    b: 1\n  c: 2\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 4, "message": "unexpected indentation" } },
    { "description": "indented first line", "input": "---\n  a: 1\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "column 1" } },
    { "description": "a mapping key after a sequence at deeper indentation", "input": "---\na:\n  - x\n  b: 1\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 4, "message": "unexpected indentation" } },
    { "description": "invalid escape", "input": "---\na: \"bad \\q\"\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "invalid escape \\q" } },
    { "description": "text after a quoted scalar", "input": "---\na: \"x\" y\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "unexpected text after a value" } },
    { "description": "reserved indicator", "input": "---\na: @handle\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "reserved indicator" } },
    { "description": "control character", "input": "---\na: x\u0007y\n---\n", "error": { "code": "E_PARSE_FRONTMATTER", "line": 2, "message": "control character" } }
  ]
}
